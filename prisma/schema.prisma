// ══════════════════════════════════════════════════════════════════════════════
// Quayer — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema
// Last updated: 2026-05-11
//
// DOMAIN MAP:
//   [1] AUTH & IDENTITY        — User, UserIdentity, Organization, UserOrganization,
//                                Session, RefreshToken, TempUser, VerificationCode,
//                                Invitation, PasskeyCredential, PasskeyChallenge,
//                                TotpDevice, RecoveryCode, DeviceSession,
//                                CustomRole, VerifiedDomain
//   [2] CONNECTIONS & MESSAGING — Connection, ConnectionSettings, ConnectionEvent,
//                                 ChatSession, Message
//   [3] ORGANIZATIONS & TEAMS  — Department, Project, ApiKey, Invitation
//   [4] AI & AGENTS            — AIAgentConfig, OrganizationProvider,
//                                N8nCallLog, BuilderProject*
//   [5] PLATFORM & INFRA       — Webhook, WebhookDelivery, AuditLog, LogEntry,
//                                LogAnalysis, Notification, NotificationRead,
//                                File, SystemSettings
//   [6] CAMPAIGNS              — Campaign, CampaignRecipient (dormant)
//
// NOTES:
//   - Tables without @@map() use PascalCase in PostgreSQL (legacy, matches init migration)
//   - DeviceSession was added via raw SQL migration (no Prisma migrate)
//   - GeoAlertMode enum added via raw SQL migration
//   - AccessLevel and SystemConfig are DEPRECATED — use CustomRole and SystemSettings
//   - 7 orphan models dropped 2026-05-11 — see docs/deprecated/SCHEMA_DORMANT_MODELS.md
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════════
// [1] AUTH & IDENTITY
// ══════════════════════════════════════════════════════════════════════════════

model Organization {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  document     String? @unique // CPF ou CNPJ (nullable via migration make_document_optional)
  type         String // "pf" ou "pj"
  maxInstances Int     @default(1)
  maxUsers     Int     @default(1)
  billingType  String  @default("free") // free, basic, pro
  isActive     Boolean @default(true)

  // Business hours configuration
  businessHoursStart String? // Format: "09:00"
  businessHoursEnd   String? // Format: "18:00"
  businessDays       String? // Format: "1,2,3,4,5" (Segunda a Sexta)
  timezone           String  @default("America/Sao_Paulo")

  // Session & Automation Settings
  sessionTimeoutHours  Int     @default(24) // 1-72 horas para encerrar sessão inativa
  notificationsEnabled Boolean @default(true)
  balancedDistribution Boolean @default(true) // Distribuir sessões entre agentes
  typingIndicator      Boolean @default(true) // Mostrar "digitando..."
  profanityFilter      Boolean @default(false) // Filtrar palavrões
  autoGreeting         Boolean @default(false) // Saudação automática
  greetingMessage      String? // Mensagem de saudação

  // Auto-Pause Hybrid Model (quando atendente assume)
  autoPauseBehavior        AutoPauseBehavior @default(WAIT_CUSTOMER) // O que fazer quando auto-pause expira
  autoPauseWaitMinutes     Int               @default(30) // Minutos para aguardar cliente (se WAIT_CUSTOMER)
  autoPauseDurationMinutes Int               @default(15) // Duração padrão do auto-pause

  // White-label Branding
  logoUrl        String? // URL do logo customizado
  primaryColor   String  @default("#000000") // Cor primária da marca
  secondaryColor String? // Cor secundária
  supportEmail   String? // Email de suporte personalizado
  customDomain   String? // Domínio customizado

  // Geo Alert (added via migration add_geo_alert_and_country_code)
  geoAlertMode GeoAlertMode @default(off)

  // Provider Configuration (Quayer Managed vs Own UAZapi)
  providerType String  @default("quayer") // "quayer" (managed) or "uazapi" (own)
  uazapiUrl    String? // URL da API UAZapi personalizada
  uazapiKey    String? // Chave de API UAZapi (encriptada)

  // SMTP Configuration
  smtpConfig Json? // { host, port, user, pass, from }

  // BYOC (Bring Your Own Credentials) Flags
  useOwnOpenAI   Boolean @default(false) // Usar própria API key OpenAI
  useOwnRedis    Boolean @default(false) // Usar próprio Redis
  useOwnDatabase Boolean @default(false) // Usar próprio PostgreSQL
  useOwnStorage  Boolean @default(false) // Usar próprio S3/Storage

  // Builder IA — vertical & language
  vertical      String? // barbearia, clinica, imobiliaria, etc.
  agentLanguage String? @default("pt-BR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           UserOrganization[]
  connections     Connection[]
  projects        Project[]
  webhooks        Webhook[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]
  providers       OrganizationProvider[]
  customRoles     CustomRole[]
  verifiedDomains VerifiedDomain[]
  invitations     Invitation[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  usageRecords    UsageRecord[]

  // Builder (home-chat-builder)
  builderProjects      BuilderProject[]
  builderConversations BuilderProjectConversation[]

  // Departamentos / roleta
  departments       Department[]
  departmentMembers DepartmentMember[]

  // Google Calendar connect-links
  calendarConnections CalendarConnection[]

  // Base de conhecimento / RAG
  knowledgeCollections KnowledgeCollection[]

  // Catálogo de preços
  priceLists PriceList[]

  @@index([document])
  @@index([slug])
  @@index([billingType])
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String // master, manager, user
  customRoleId   String? // FK to CustomRole (nullable for legacy compatibility)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([customRoleId])
}

model CustomRole {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  permissions    Json // Matches PERMISSIONS_MATRIX structure: { resource: [action, ...] }
  isSystem       Boolean  @default(false)
  priority       Int // 3=master, 2=manager, 1=user
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userOrganizations UserOrganization[]
  verifiedDomains   VerifiedDomain[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("custom_roles")
}

model VerifiedDomain {
  id                 String    @id @default(uuid())
  organizationId     String
  domain             String
  verificationMethod String // DNS_TXT or EMAIL
  verificationToken  String
  verifiedAt         DateTime?
  defaultRoleId      String? // FK to CustomRole for auto-join
  autoJoin           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultRole  CustomRole?  @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
  @@map("verified_domains")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  emailVerified DateTime?
  currentOrgId  String? // Org ativa no momento
  role          String    @default("user") // admin (sistema), user
  isActive      Boolean   @default(true)

  // Onboarding
  onboardingCompleted Boolean @default(false)

  // Phone (added via migration add_user_phone)
  phone         String?
  phoneVerified Boolean @default(false)

  // Two-Factor Authentication
  twoFactorEnabled Boolean @default(false)

  // Profile / Agency (Builder IA)
  isAgency  Boolean @default(false)
  language  String? @default("pt-BR")
  timezone  String? @default("America/Sao_Paulo")
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences             UserPreferences?
  notificationPreferences NotificationPreferences?

  sessions            Session[]
  refreshTokens       RefreshToken[]
  invitations         Invitation[]       @relation("InvitedBy")
  organizations       UserOrganization[]
  auditLogs           AuditLog[]
  verificationCodes   VerificationCode[]
  files               File[]
  assignedConnections Connection[]       @relation("AssignedCustomer")

  passkeyCredentials PasskeyCredential[]
  totpDevices        TotpDevice[]
  recoveryCodes      RecoveryCode[]
  deviceSessions     DeviceSession[]
  promptVersions     AgentPromptVersion[]
  identities         UserIdentity[]

  // Builder (home-chat-builder)
  builderProjects                BuilderProject[]
  builderProjectConversations    BuilderProjectConversation[]
  builderPublishedPromptVersions BuilderPromptVersion[]       @relation("BuilderPromptVersionPublisher")

  // Departamentos / roleta
  departmentMemberships    DepartmentMember[] @relation("DepartmentMembership")
  lastAssignedDepartments  Department[]       @relation("DepartmentLastAssigned")
  assignedSessions         ChatSession[]      @relation("SessionAssignedAgent")
  assignedCustomerSessions ChatSession[]      @relation("SessionAssignedCustomer")

  @@index([email])
  @@index([currentOrgId])
  @@index([role])
  @@index([phone])
}

// ── User Identities (federated login providers) ──────────────────────────────
// Tracks which login methods are linked to each user (Google OAuth, WhatsApp
// phone, etc). Allows users to manage linked providers in /conta and prevents
// removal of the last authentication method.
//
// `provider` examples: "google", "whatsapp"
// `providerUserId` is the stable ID returned by the provider (Google `sub`,
// phone E.164). For `password` and `passkey` the link is implicit in the
// `User` / `PasskeyCredential` tables, so they are not stored here.

model UserIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String // "google", "whatsapp"
  providerUserId String // Google `sub`, phone E.164
  identifier     String // Display label: email Google, telefone formatado
  connectedAt    DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

// ── User Preferences ─────────────────────────────────────────────────────────

model UserPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique
  messageSignature     Json?    @db.JsonB // { enabled, format, department, customText, showPreview }
  aiSuggestionsEnabled Boolean  @default(true)
  otpEmailDisabled     Boolean  @default(false)
  otpPhoneDisabled     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Notification Preferences (per-user channel opt-ins) ──────────────────────

model NotificationPreferences {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailSecurity   Boolean  @default(true)
  emailProduct    Boolean  @default(true)
  emailMarketing  Boolean  @default(false)
  pushEnabled     Boolean  @default(false)
  pushMentions    Boolean  @default(true)
  pushDeployments Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

// ── Passkeys / WebAuthn ──────────────────────────────────────────────────────

model PasskeyCredential {
  id                   String   @id @default(uuid())
  userId               String
  credentialId         String   @unique // Base64URL encoded credential ID
  publicKey            Bytes // COSE public key
  counter              BigInt   @default(0) // Signature counter for clone detection
  credentialDeviceType String   @default("singleDevice") // singleDevice or multiDevice
  credentialBackedUp   Boolean  @default(false)
  transports           String[] // Transports supported by authenticator (usb, ble, nfc, internal)

  // User-friendly name for the passkey
  name String @default("Minha Passkey")

  // AAGUID for device identification (optional)
  aaguid String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@index([lastUsedAt])
}

// Temporary challenge for WebAuthn operations
model PasskeyChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique // Base64URL encoded challenge
  userId    String? // Optional for registration (user not yet authenticated)
  email     String? // For login without userId
  type      String // "registration" or "authentication"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

// Temporary user for signup (before email verification)
model TempUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expiresAt])
}

// Verification codes (OTP, Magic Link, etc)
model VerificationCode {
  id         String   @id @default(uuid())
  userId     String?
  identifier String // email address or phone number
  code       String
  type       String // OTP, MAGIC_LINK, RESET_PASSWORD, EMAIL_VERIFICATION, WHATSAPP_OTP, TOTP_DISABLE
  token      String? // For magic links (JWT token)
  used       Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, type])
  @@index([code])
  @@index([token])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  token          String    @unique @default(uuid())
  role           String    @default("user")
  organizationId String
  invitedById    String
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invitedById])
  @@index([organizationId])
  @@index([token])
  @@index([expiresAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// [3] ORGANIZATIONS & TEAMS
// ══════════════════════════════════════════════════════════════════════════════

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  type           String   @default("support") // support, sales, custom
  isActive       Boolean  @default(true)

  // Round-robin (roleta) — ponteiro do último atendente sorteado. A próxima
  // escolha é o primeiro membro ATIVO após este, em ordem circular por
  // (position, createdAt). NULL = roleta nunca rodou (começa do primeiro).
  lastAssignedUserId   String? // legado/vestigial: cursor antigo por User.id (tem FK física p/ User)
  lastAssignedMemberId String? // M1 — cursor por DepartmentMember.id (SEM FK; membro pode ser não-usuário)
  lastAssignedAt       DateTime?

  // B1b warm transfer — mensagem de abertura editável que a conexão do membro envia
  // ao cliente no handoff (interpola {nome}). NULL = usa o texto default de
  // warm-transfer.ts. Materializada por materialize_team de builderState.team.openingMessage.
  warmTransferOpeningMessage String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastAssignedUser User?              @relation("DepartmentLastAssigned", fields: [lastAssignedUserId], references: [id], onDelete: SetNull)
  members          DepartmentMember[]
  chatSessions     ChatSession[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
  @@index([type])
  @@index([isActive])
  @@index([lastAssignedUserId])
}

// Membros do departamento (fila da roleta). `position` define a ordem; `isActive`
// permite pausar um atendente sem removê-lo.
model DepartmentMember {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String
  userId         String? // M1 — nullable: membro "nome + WhatsApp" não é usuário da plataforma
  name           String? // M1 — nome de exibição do membro (não-usuário)
  whatsapp       String? // M1 — WhatsApp do membro; a roleta roteia a notificação pra cá
  // F0 (épico QR/warm-transfer): Connection.id da instância WhatsApp PRÓPRIA do membro
  // (pareada por QR). Quando setado, o handoff faz warm transfer (a conexão do membro
  // manda a 1ª mensagem ao cliente). Scalar SEM FK (espelha lastAssignedMemberId) —
  // resolvido por findUnique no runtime; fail-open quando ausente/inválido.
  connectionId   String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User?        @relation("DepartmentMembership", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([departmentId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([userId])
  @@index([departmentId, isActive, position])
  @@map("department_members")
}

// ── Projects ──────────────────────────────────────────────────────────────────

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connections  Connection[]

  @@index([organizationId])
}

// ══════════════════════════════════════════════════════════════════════════════
// [2] CONNECTIONS & MESSAGING
// ══════════════════════════════════════════════════════════════════════════════

model Connection {
  id   String @id @default(uuid())
  name String

  // Channel & Provider
  channel  Channel  @default(WHATSAPP)
  provider Provider @default(WHATSAPP_WEB)

  // Connection Status
  status            ConnectionStatus @default(DISCONNECTED)
  phoneNumber       String?
  profileName       String?
  profilePictureUrl String?
  isBusiness        Boolean          @default(false)

  // uazapi Integration
  uazapiInstanceId     String?   @unique // ID na uazapi
  uazapiToken          String? // Token encriptado da instância
  qrCode               String?   @db.Text
  pairingCode          String?
  lastConnected        DateTime?
  lastDisconnect       DateTime?
  lastDisconnectReason String?

  // WhatsApp Cloud API Integration (Official Meta API)
  cloudApiAccessToken   String? @map("cloud_api_access_token") @db.Text // System User Token (pode ser longo)
  cloudApiPhoneNumberId String? @map("cloud_api_phone_number_id") // Phone Number ID do Meta Business
  cloudApiWabaId        String? @map("cloud_api_waba_id") // WhatsApp Business Account ID
  cloudApiVerifiedName  String? @map("cloud_api_verified_name") // Nome verificado da conta business
  cloudApiVerifyToken   String? @map("cloud_api_verify_token") // Verify token do webhook (Meta GET challenge)

  // Instagram Direct Integration (Meta — credenciais manuais; sem parceria oficial)
  igAccountId       String? @map("ig_account_id") // Instagram Business Account ID
  igPageAccessToken String? @map("ig_page_access_token") @db.Text // Page Access Token (pode ser longo)
  igAppSecret       String? @map("ig_app_secret") // App Secret (valida assinatura X-Hub do webhook)
  igVerifyToken     String? @map("ig_verify_token") // Verify token do webhook

  // n8n Integration (AI Agent)
  n8nWebhookUrl  String? // URL do workflow n8n
  n8nWorkflowId  String? // ID do workflow
  n8nFallbackUrl String? // URL de fallback
  agentConfig    Json? // { prompt, tools, model, temperature }

  // Organization & Project
  organizationId String? // Nullable para permitir instâncias sem organização (admin)
  projectId      String?

  // Customer Assignment (Admin only)
  assignedCustomerId String? // ID do cliente/usuário atribuído pelo admin

  // Message Delay Config
  msgDelayMin Int @default(2)
  msgDelayMax Int @default(4)

  // Share Token System
  shareToken               String?   @unique
  shareTokenExpiresAt      DateTime?
  shareTokenExtensionCount Int       @default(0) // Max 3 extensions allowed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedCustomer User?             @relation("AssignedCustomer", fields: [assignedCustomerId], references: [id], onDelete: SetNull)
  webhooks         Webhook[]
  chatSessions     ChatSession[]
  messages         Message[]
  n8nCallLogs      N8nCallLog[]
  agentDeployments AgentDeployment[]

  // Advanced Settings
  settings ConnectionSettings?

  // Connection Events History
  events ConnectionEvent[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([channel])
  @@index([provider])
  @@index([uazapiInstanceId])
  @@index([cloudApiPhoneNumberId])
  @@index([shareToken])
  @@index([n8nWorkflowId])
  @@map("connections")
}

// ── Connection Settings ───────────────────────────────────────────────────────

model ConnectionSettings {
  id           String @id @default(uuid())
  connectionId String @unique

  // ===== CONCATENAÇÃO DE MENSAGENS =====
  concatEnabled     Boolean @default(true)
  concatTimeoutMs   Int     @default(8000) // 8 segundos
  concatMaxMessages Int     @default(10)
  concatSameType    Boolean @default(false) // false = concat tudo junto (melhor para IA)
  concatSameSender  Boolean @default(true) // apenas mesmo remetente

  // ===== TRANSCRIÇÃO & IA =====
  transcriptionEnabled      Boolean @default(true)
  imageDescriptionEnabled   Boolean @default(true)
  documentAnalysisEnabled   Boolean @default(true)
  videoTranscriptionEnabled Boolean @default(true)

  // ===== GEOCODING =====
  geocodingEnabled Boolean @default(true)
  geocodingApiKey  String? // Se vazio, usa da organização ou sistema

  // ===== AI MODELS (override do padrão) =====
  transcriptionModel String? // whisper-1
  visionModel        String? // gpt-4o
  analysisModel      String? // gpt-4o

  // ===== AI PROMPTS (override do padrão) =====
  imagePrompt    String? @db.Text
  audioPrompt    String? @db.Text
  documentPrompt String? @db.Text
  videoPrompt    String? @db.Text

  // ===== WHATSAPP 24H WINDOW =====
  enforceWhatsAppWindow   Boolean @default(true)
  templateFallbackEnabled Boolean @default(false)

  // ===== BOT ECHO DETECTION =====
  botEchoEnabled Boolean @default(true)
  botSignature   String? // Custom signature (default: \u200B\u200C\u200D)

  // ===== AUTO-PAUSE =====
  autoPauseOnHumanReply  Boolean @default(true)
  autoPauseDurationHours Int     @default(24)

  // ===== COMANDOS VIA CHAT =====
  commandsEnabled Boolean @default(true)
  commandPrefix   String  @default("@") // @fechar, @pausar

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("connection_settings")
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  EMAIL
}

enum Provider {
  WHATSAPP_WEB
  WHATSAPP_CLOUD_API
  WHATSAPP_BUSINESS_API
  INSTAGRAM_META
  TELEGRAM_BOT
  EMAIL_SMTP
}

enum ConnectionStatus {
  CONNECTED
  CONNECTING
  DISCONNECTED
  ERROR
}

// ── Connection Events ─────────────────────────────────────────────────────────

model ConnectionEvent {
  id           String @id @default(uuid())
  connectionId String

  // Event Info
  eventType  ConnectionEventType
  fromStatus ConnectionStatus?
  toStatus   ConnectionStatus

  // Context
  reason    String? // Reason for disconnection/error
  metadata  Json? // Additional context (qr_timeout, manual, etc)
  ipAddress String? // IP where event originated
  userAgent String? // Browser/Device info

  // User who triggered (if manual action)
  triggeredBy String? // User ID if manual

  // Timestamps
  createdAt DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("connection_events")
}

enum ConnectionEventType {
  CONNECTED // Successfully connected
  DISCONNECTED // Disconnected (manual or automatic)
  CONNECTION_LOST // Unexpected disconnection
  QR_GENERATED // QR Code generated for pairing
  QR_SCANNED // QR Code was scanned
  QR_TIMEOUT // QR Code expired without scan
  QR_RETRY // Automatic QR retry triggered
  ERROR // Connection error occurred
  RECONNECTING // Attempting to reconnect
}

// ── N8n Call Logs ─────────────────────────────────────────────────────────────

model N8nCallLog {
  id           String @id @default(uuid())
  connectionId String

  // Request Info
  url     String
  payload Json

  // Response Info
  success    Boolean
  statusCode Int?
  response   Json?
  error      String? @db.Text

  // Performance
  latency Int // Milliseconds

  createdAt DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([success])
  @@index([createdAt])
  @@map("n8n_call_logs")
}

// ══════════════════════════════════════════════════════════════════════════════
// [5] PLATFORM & INFRA
// ══════════════════════════════════════════════════════════════════════════════

model Webhook {
  id             String   @id @default(uuid())
  url            String
  events         String[] // ["connection.created", "message.received", etc]
  description    String?
  secret         String? // HMAC secret for signature verification
  isActive       Boolean  @default(true)
  connectionId   String?
  organizationId String?

  // Filtros avançados (inspirado em UAZ API)
  excludeMessages     Boolean  @default(false) // Excluir mensagens do webhook
  addUrlEvents        Boolean  @default(false) // Adicionar eventos específicos na URL
  addUrlTypesMessages String[] @default([]) // Tipos de mensagem na URL: ["text", "image", "audio"]
  pathParams          Json? // Path parameters dinâmicos {"{userId}": "123"}

  // Retry configuration
  maxRetries Int @default(3)
  retryDelay Int @default(5000) // milliseconds
  timeout    Int @default(30000) // milliseconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection   Connection?       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([connectionId])
  @@index([organizationId])
  @@index([isActive])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  webhookId   String
  event       String
  payload     Json
  response    Json?
  status      String    @default("pending") // pending, success, failure
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String // create, update, delete, login, etc
  resource       String // organization, instance, user, etc
  resourceId     String?
  userId         String
  organizationId String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// ── Permissions (DB-driven RBAC) ─────────────────────────────────────────────
// ⚠️  AccessLevel below is DEPRECATED — use CustomRole in [1] Auth instead

// Define recursos e ações disponíveis no sistema
model PermissionResource {
  id          String   @id @default(uuid())
  resource    String   @unique // organizations, users, connections, messages, etc
  displayName String // Nome amigável
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@index([resource])
  @@index([isActive])
  @@map("permission_resources")
}

// Mapeia permissões por role
model RolePermission {
  id         String   @id @default(uuid())
  resourceId String
  role       String // admin, master, manager, agent, viewer
  actions    String[] // create, read, update, delete, manage, export, etc

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, role])
  @@index([role])
  @@index([resourceId])
  @@map("role_permissions")
}

// ── Chat Sessions & Messages ──────────────────────────────────────────────────

model ChatSession {
  id             String @id @default(uuid())
  contactPhone   String // WhatsApp phone number (formerly linked to Contact)
  connectionId   String
  organizationId String

  // Status
  status       SessionStatus    @default(QUEUED)
  startedBy    SessionStartedBy @default(CUSTOMER)
  statusReason String?
  endReason    String?
  externalId   String?

  // Assignment
  assignedDepartmentId String?
  assignedAgentId      String?
  assignedCustomerId   String?

  // IA Control
  aiEnabled      Boolean   @default(true)
  aiBlockedUntil DateTime?
  aiBlockReason  String?

  // AI Agent Configuration (qual agente IA está atendendo)
  aiAgentConfigId String? // FK para AIAgentConfig
  aiAgentId       String? // ID do agente IA ativo (pode ser de sistema externo)
  aiAgentName     String? // Nome do agente IA
  aiAgentTarget   String? // Target/objetivo do agente (ex: "vendas", "suporte")
  aiAgentBehavior String? // Comportamento específico do agente
  aiAgentContext  Json? // Contexto adicional do agente

  // Sticky agent version pinning (Builder US-004)
  // When set, conversation stays on this version until 24h idle
  pinnedAgentVersion Int?

  // Customer Journey Tracking
  customerJourney       String?   @default("new") // new, returning, qualified, etc
  journeyStage          String? // Estágio atual na jornada
  journeyUpdatedAt      DateTime? // Última atualização da jornada
  leadScore             Int? // Score do lead (0-100)
  conversionProbability Float? // Probabilidade de conversão (0-1)

  // Session Analytics
  totalMessages      Int   @default(0)
  totalAiMessages    Int   @default(0)
  totalAgentMessages Int   @default(0)
  totalMediaMessages Int   @default(0)
  avgResponseTime    Int? // Tempo médio de resposta em segundos
  sessionDuration    Int? // Duração total em segundos
  totalAiCost        Float @default(0) // Custo total de IA da sessão

  // Timing & Expiration
  lastMessageAt       DateTime  @default(now())
  lastMessageAuthorId String? // ID of user who sent last message (for signature logic)
  expiresAt           DateTime? // Calculated expiration based on org timeout
  pausedUntil         DateTime? // For @pausar command with time limit
  pausedBy            String? // Who paused: "command", "agent", "system"

  // WhatsApp 24h Window (compliance with WhatsApp Business API)
  lastCustomerMessageAt   DateTime? // Last message FROM customer (inbound)
  whatsappWindowExpiresAt DateTime? // 24h from last customer message
  whatsappWindowType      String?   @default("CUSTOMER_INITIATED") // CUSTOMER_INITIATED, BUSINESS_INITIATED

  // Concatenação
  isConcat      Boolean @default(false)
  concatTimeout Int     @default(8)

  // Metadata
  tags         String[] @default([])
  customFields Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // Relacionamentos
  connection    Connection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedAgent    User?       @relation("SessionAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedCustomer User?       @relation("SessionAssignedCustomer", fields: [assignedCustomerId], references: [id], onDelete: SetNull)
  aiAgentConfig AIAgentConfig? @relation(fields: [aiAgentConfigId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([contactPhone])
  @@index([connectionId])
  @@index([organizationId])
  @@index([status])
  @@index([aiBlockedUntil])
  @@index([lastMessageAt])
  @@index([expiresAt])
  @@index([pausedUntil])
  @@index([whatsappWindowExpiresAt])
  @@index([assignedDepartmentId])
  @@index([assignedAgentId])
  @@index([externalId])
  @@index([aiAgentConfigId])
  @@index([customerJourney])
  @@index([pinnedAgentVersion])
}

enum SessionStatus {
  QUEUED // Aguardando atendimento
  ACTIVE // Em atendimento
  PAUSED // Pausada (aguardando resposta)
  CLOSED // Encerrada
}

enum SessionStartedBy {
  CUSTOMER // Iniciada pelo cliente
  BUSINESS // Iniciada pela empresa
  AGENT // Iniciada por agente
}

// ── Auto-Pause & Group Enums ──────────────────────────────────────────────────

enum AutoPauseBehavior {
  CLOSE_SESSION // Encerra sessão imediatamente quando auto-pause expira
  WAIT_CUSTOMER // Aguarda cliente por X minutos, depois fecha
}

// Geo Alert Mode — added via migration add_geo_alert_and_country_code
enum GeoAlertMode {
  off // Sem alerta
  notify // Notifica admin quando login de país novo
  block // Bloqueia login de país diferente do último
}

model Message {
  id           String @id @default(uuid())
  sessionId    String
  contactPhone String // WhatsApp phone number (formerly linked to Contact)
  connectionId String

  // Mensagem
  waMessageId String           @unique
  direction   MessageDirection
  type        MessageType
  author      MessageAuthor    @default(CUSTOMER)
  content     String           @db.Text

  // Conteúdo Formatado/Raw (para tracking de transformações)
  rawContent       String? @db.Text // Conteúdo original antes de sanitização
  formattedContent String? @db.Text // Conteúdo formatado/processado

  // Mídia
  mediaUrl      String?
  mediaType     String?
  mimeType      String?
  fileName      String?
  mediaSize     Int?
  mediaDuration Int?

  // Location Data (quando type = 'location')
  latitude     Float?
  longitude    Float?
  locationName String? // Nome do local enviado pelo usuário

  // Geocoded Address (preenchido automaticamente via Google Maps API)
  geoAddress      String? // Endereço completo formatado
  geoNeighborhood String? // Bairro
  geoCity         String? // Cidade
  geoState        String? // Estado (ex: São Paulo)
  geoStateCode    String? // Código do estado (ex: SP)
  geoPostalCode   String? // CEP
  geoCountry      String? // País

  // Transcrição
  transcription            String?             @db.Text
  transcriptionLanguage    String?
  transcriptionConfidence  Float?
  transcriptionStatus      TranscriptionStatus @default(pending)
  transcriptionProcessedAt DateTime?
  transcriptionError       String?

  // Status WhatsApp
  status      MessageStatus @default(pending)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  // Concatenação
  isConcatenated Boolean @default(false)
  concatGroupId  String?

  // AI Response Tracking (quando a mensagem é resposta de IA)
  aiModel      String? // gpt-4o, claude-3, etc
  aiAgentId    String? // ID do agente que respondeu
  aiAgentName  String? // Nome do agente
  inputTokens  Int? // Tokens de entrada (prompt)
  outputTokens Int? // Tokens de saída (completion)
  cachedTokens Int? // Tokens em cache (economia)
  inputCost    Float? // Custo dos tokens de entrada
  outputCost   Float? // Custo dos tokens de saída
  cacheSavings Float? // Economia por cache
  totalCost    Float? // Custo total da chamada
  aiLatency    Int? // Latência da resposta em ms
  aiProvider   String? // openai, anthropic, groq, etc

  // Callback/Webhook Origin
  callbackSource  String? // webhook_id ou "n8n", "make", etc
  callbackPayload Json? // Payload original do callback

  // Metadata
  quotedMessageId String?
  isForwarded     Boolean @default(false)
  forwardedInfo   Json?
  metadata        Json? // Metadata adicional flexível

  createdAt DateTime @default(now())

  // Relacionamentos
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  connection Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([contactPhone])
  @@index([connectionId])
  @@index([waMessageId])
  @@index([concatGroupId])
  @@index([transcriptionStatus])
  @@index([aiAgentId])
  @@index([aiModel])
  @@index([createdAt])
}

// ── ContactMemory ─────────────────────────────────────────────────────────────
// Perfil vitalício do contato (por org + telefone). Diferente do summary por
// sessão (ChatSession.aiAgentContext.summary), este é um perfil cumulativo que
// agrega o histórico de TODAS as sessões fechadas: "quem é o cliente, o que
// quer, histórico". Atualizado a cada fechamento+resumo de sessão e injetado no
// system prompt do agente (## Perfil do cliente). Multi-tenant por
// organizationId; sem FK relation (lookup direto por org+phone).
model ContactMemory {
  id                String   @id @default(uuid())
  organizationId    String
  contactPhone      String // WhatsApp phone number (mesma chave de ChatSession)
  aggregatedProfile String   @db.Text // perfil cumulativo gerado por LLM
  sessionCount      Int      @default(0) // nº de sessões já agregadas no perfil
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, contactPhone])
  @@index([organizationId])
  @@map("contact_memories")
}

enum MessageDirection {
  INBOUND // Recebida
  OUTBOUND // Enviada
}

enum MessageType {
  text
  image
  video
  audio
  voice // PTT - Push to Talk
  document
  location
  contact
  sticker
  poll
  list
  buttons
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum TranscriptionStatus {
  pending // Aguardando processamento
  processing // Em processamento
  completed // Concluída com sucesso
  failed // Falhou
  skipped // Pulada (não aplicável)
}

enum MessageAuthor {
  CUSTOMER // Cliente final
  AGENT // Atendente humano
  AI // IA/Bot
  BUSINESS // Empresa/Sistema
  SYSTEM // Sistema automático
  AGENT_PLATFORM // Plataforma de agente
}

// ══════════════════════════════════════════════════════════════════════════════
// [6] CAMPAIGNS & TEMPLATES (dormant — kept for Communication module)
// ══════════════════════════════════════════════════════════════════════════════

model Campaign {
  id             String    @id @default(uuid())
  organizationId String
  connectionId   String
  name           String
  status         String    @default("draft") // draft | scheduled | running | completed | failed | cancelled
  scheduledAt    DateTime?
  message        String    @db.Text
  mediaUrl       String?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([organizationId])
  @@index([connectionId])
  @@index([status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id          String    @id @default(uuid())
  campaignId  String
  contactId   String?
  phoneNumber String
  status      String    @default("pending") // pending | sent | delivered | failed
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@map("campaign_recipients")
}

// ── Files ─────────────────────────────────────────────────────────────────────

model File {
  id             String   @id @default(uuid())
  organizationId String
  userId         String // Uploader
  fileName       String
  fileSize       Int // Bytes
  mimeType       String
  url            String // S3/CDN URL or local path
  thumbnail      String? // Thumbnail URL for images/videos
  metadata       Json? // Additional metadata (dimensions, duration, etc)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([mimeType])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// [4] AI & AGENTS
// ══════════════════════════════════════════════════════════════════════════════

// ── BYOC Provider (Bring Your Own Credentials) ───────────────────────────────

enum ProviderCategory {
  AI // LLMs: openai, anthropic, google, openrouter
  TRANSCRIPTION // STT: whisper, deepgram, assemblyai
  TTS // Text-to-Speech: elevenlabs, openai-tts
  INFRASTRUCTURE // redis, postgresql, supabase, s3
  AUXILIARY // google-maps, email, sms
}

// ── Organization Providers ────────────────────────────────────────────────────

model OrganizationProvider {
  id             String @id @default(uuid())
  organizationId String

  // Label amigável (ex: "Chave Prod", "Chave Dev")
  name String @default("")

  // Tipo do provedor
  category ProviderCategory
  provider String // openai, anthropic, redis, supabase, etc

  // Escopo: null = organização, set = override de um projeto Builder específico
  builderProjectId String?

  // Configuração
  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // Provedor principal da categoria
  priority  Int     @default(0) // Para fallback ordering (menor = maior prioridade)

  // Credenciais (encriptadas no nível da aplicação)
  credentials Json // { apiKey, apiSecret, apiUrl, region, bucket, etc }

  // Configurações específicas do provedor
  settings Json? // { model: "gpt-4o", maxTokens: 4096, temperature: 0.7, etc }

  // Metadados de uso
  lastTestedAt   DateTime?
  lastTestStatus String? // success, failed, pending
  lastTestError  String?
  usageThisMonth Int       @default(0) // Para tracking de uso
  costThisMonth  Float     @default(0) // Custo estimado do mês

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderProject BuilderProject? @relation(fields: [builderProjectId], references: [id], onDelete: Cascade)
  agentCredentials AIAgentConfig[] @relation("AgentCredential") // agentes que escolheram esta chave

  @@unique([organizationId, category, provider, builderProjectId, priority])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@index([category, provider])
  @@index([builderProjectId])
  @@map("organization_providers")
}

// ── Calendar Connections (Google Calendar connect-link — Wave 4b) ────────────
// Estado do LINK público de conexão (análogo ao Connection.shareToken). O token
// OAuth em si (refresh_token) NÃO fica aqui — vai encriptado em
// OrganizationProvider (provider='google-calendar', category AUXILIARY).

enum CalendarConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
}

model CalendarConnection {
  id               String @id @default(uuid())
  organizationId   String
  builderProjectId String? // null = nível org; set = link específico do projeto

  connectToken          String   @unique
  connectTokenExpiresAt DateTime

  status        CalendarConnectionStatus @default(PENDING)
  calendarEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderProject BuilderProject? @relation(fields: [builderProjectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([builderProjectId])
  @@index([status])
  @@index([connectToken])
  @@map("calendar_connections")
}

// ── Short Links with Click Tracking (Features module) ────────────────────────

model ShortLink {
  id             String    @id @default(uuid())
  organizationId String
  originalUrl    String    @db.Text
  slug           String    @unique
  clicks         Int       @default(0)
  createdById    String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  clickEvents ShortLinkClick[]

  @@index([organizationId])
  @@index([slug])
  @@map("short_links")
}

model ShortLinkClick {
  id          String   @id @default(uuid())
  shortLinkId String
  ipAddress   String?
  userAgent   String?
  countryCode String?
  clickedAt   DateTime @default(now())

  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId])
  @@index([clickedAt])
  @@map("short_link_clicks")
}

// AI Agent Configuration per Organization
model AIAgentConfig {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  isActive       Boolean @default(true)

  // Model settings
  provider    String @default("openai") // openai, anthropic, groq
  model       String @default("gpt-4o")
  temperature Float  @default(0.7)
  maxTokens   Int    @default(4096)

  // System prompt
  systemPrompt String? @db.Text
  personality  String?

  // Agent Identity (para tracking e analytics)
  agentTarget   String? // "vendas", "suporte", "atendimento"
  agentBehavior String? // Comportamento padrão
  agentAvatar   String? // URL do avatar

  // Memory settings
  useMemory    Boolean @default(true)
  memoryWindow Int     @default(10) // Number of messages to remember

  // RAG settings
  useRAG          Boolean @default(false)
  ragCollectionId String?

  // Catálogo de preços (tool get_pricing lê desta lista)
  priceListId String?

  // Departamento da roleta (vínculo ESTRUTURADO agente↔departamento). O dispatch_to_agent
  // usa este id como fallback quando o LLM não passa um departmentId válido — robusto a
  // qual tabela de prompt vence (o bloco no systemPrompt pode ser sombreado por AgentPromptVersion).
  departmentId String?

  // Horário comercial materializado do builderState (card business_hours) p/ o runtime.
  // Forma: { schedule: WeeklySchedule (opaco), timezone?: string, preset?: string }.
  // Usado pelo transfer_to_human (computeBusinessState) para devolver `atendimento`.
  businessHours Json?

  // BYOK por agente: qual chave (OrganizationProvider) este agente usa.
  // null = resolução por fallback (isPrimary → priority → primeira ativa).
  organizationProviderId String?

  // Activation mode (Orayon): controla QUAIS mensagens inbound disparam a IA.
  // 'all'                  → toda inbound dispara (comportamento legado / default).
  // 'all_except_blacklist' → dispara, exceto contatos com tag 'blacklist' na session.
  // 'keyword_trigger'      → só dispara se o texto contém alguma activationKeyword.
  // 'whitelist_only'       → só dispara se a session tem tag 'whitelist'.
  activationMode     String   @default("all")
  activationKeywords String[] @default([]) // usado por activationMode='keyword_trigger'

  // Tool settings
  enabledTools String[] @default([])

  // TTS Settings (Text-to-Speech)
  enableTTS     Boolean @default(false)
  ttsProvider   String? // "elevenlabs", "openai", "google"
  ttsVoiceId    String? // ID da voz (ex: ElevenLabs voice ID)
  ttsModel      String? // Modelo TTS
  ttsSpeechRate Float?  @default(1.0) // Velocidade da fala

  // Callback settings
  callbackUrl    String?
  callbackSecret String?

  // Cost tracking (agregado por agente)
  totalInputTokens  Int   @default(0)
  totalOutputTokens Int   @default(0)
  totalCachedTokens Int   @default(0)
  totalCost         Float @default(0)
  totalCacheSavings Float @default(0)
  totalCalls        Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  sessions       ChatSession[]
  promptVersions AgentPromptVersion[]
  deployments    AgentDeployment[]
  ragCollection  KnowledgeCollection? @relation(fields: [ragCollectionId], references: [id], onDelete: SetNull)
  priceList      PriceList?           @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  credential     OrganizationProvider? @relation("AgentCredential", fields: [organizationProviderId], references: [id], onDelete: SetNull)

  // Builder (home-chat-builder)
  builderProject        BuilderProject?
  builderPromptVersions BuilderPromptVersion[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
}

// ── Knowledge Base / RAG (pgvector — Wave RAG) ───────────────────────────────
// pgvector no Postgres da app (= Supabase, extensão já instalada). A coluna
// embedding é Unsupported("vector(1536)") — INSERT/SELECT do vetor SEMPRE via
// $executeRaw/$queryRaw (Prisma não tipa vector). Índice HNSW vai na migration.

model KnowledgeCollection {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  description    String?
  embeddingModel String  @default("text-embedding-3-small")
  dimensions     Int     @default(1536)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources      KnowledgeSource[]
  chunks       KnowledgeChunk[]
  images       KnowledgeImage[]
  mediaAssets  MediaAsset[]
  agents       AIAgentConfig[] // agentes que apontam ragCollectionId pra cá

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("knowledge_collections")
}

model KnowledgeSource {
  id             String  @id @default(uuid())
  collectionId   String
  organizationId String
  type           String // 'pdf' | 'url' | 'text'
  source         String // nome do arquivo ou URL
  storageKey     String? // chave no Supabase storage (PDF original)
  status         String  @default("pending") // pending|processing|ready|error
  error          String? @db.Text
  chunkCount     Int     @default(0)
  imagesEnabled  Boolean @default(true) // Onda D (G2) — toggle do catálogo visual por fonte

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chunks     KnowledgeChunk[]
  images     KnowledgeImage[]

  @@index([collectionId])
  @@index([organizationId])
  @@index([status])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id           String  @id @default(uuid())
  collectionId String
  sourceId     String?

  content   String                       @db.Text
  embedding Unsupported("vector(1536)")? // lida/escrita SOMENTE via raw
  metadata  Json? // { page, heading, tokens, ... }
  ordinal   Int                          @default(0)

  createdAt DateTime @default(now())

  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source     KnowledgeSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

// ── Catálogo Visual das Fontes (Onda D / G2 — visão/imagens) ─────────────────
// Fotos extraídas do site/Instagram colado. Persiste o storageKey (path no bucket
// MEDIA), NÃO a signed URL (que expira) — assina on-read. captionEmbedding é
// NULLABLE e só é populado na fase de runtime (busca vetorial da galeria); como o
// KnowledgeChunk, INSERT/SELECT do vetor SEMPRE via raw. As imagens vivem nesta
// tabela (nunca no builderState JSONB, que recebe só um flag leve).
model KnowledgeImage {
  id               String                       @id @default(uuid())
  organizationId   String // tenant boundary explícito (carimbo, igual KnowledgeSource)
  collectionId     String // = kb:${projectId}
  sourceId         String // FK KnowledgeSource (a fonte colada)
  originalUrl      String                       @db.Text // URL de origem no site/IG
  storageKey       String // path no BUCKETS.MEDIA — assina on-read (não persiste URL)
  caption          String?                      @db.Text // legenda vision-LLM, editável
  captionEmbedding Unsupported("vector(1536)")? // NULL no MVP; lida/escrita SOMENTE via raw
  width            Int?
  height           Int?
  sizeBytes        Int?
  sha256           String // dedup content-addressed
  mimeType         String?
  confirmedAt      DateTime? // curadoria: NULL = pendente (aprovada em D2/D3); runtime filtra confirmedAt IS NOT NULL
  deletedAt        DateTime? // soft-delete (GET/runtime filtram deletedAt IS NULL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source     KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sha256]) // dedup por fonte
  @@index([collectionId])
  @@index([organizationId])
  @@index([sourceId])
  @@map("knowledge_images")
}

// ── Catálogo de Mídia (Fase E) ───────────────────────────────────────────────
// Catálogo UNIFICADO de mídia ENVIÁVEL pelo agente (foto/vídeo/PDF) — NÃO áudio
// (áudio é dinâmico, sai pelo outbound/TTS). A tool `buscar_media` lê daqui e
// devolve URLs REAIS ao LLM, que emite a tag de mídia ([url da imagem:...] /
// [video:...] / [document:...]); o pipeline outbound (tag-parser → uazapi-sender)
// é quem ENVIA. Origens: upload manual + materialização da galeria (KnowledgeImage)
// e das fotos de preço (PriceItem) no deploy. Scope por collection (kb:projectId),
// igual ao RAG/galeria. storageKey = path no bucket (assina on-read); externalUrl
// quando a mídia já é uma URL pública externa.
model MediaAsset {
  id             String   @id @default(uuid())
  organizationId String // tenant boundary explícito (carimbo)
  collectionId   String // = ragCollectionId do agente (kb:projectId)
  mediaType      String // 'image' | 'video' | 'document'
  storageKey     String? // path no BUCKETS.MEDIA (assina on-read) — uploads + materializados
  externalUrl    String? // URL pública externa (ex: foto de preço hospedada fora)
  mimeType       String?
  caption        String?  @db.Text // legenda/título (usada na tag de mídia)
  tags           String[] @default([]) // palavras-chave p/ o filtro simples (sem vetor)
  category       String?
  source         String   @default("upload") // 'upload' | 'gallery' | 'pricing'
  sourceRef      String? // id de origem (KnowledgeImage.id / PriceItem.id) p/ materialize idempotente
  sizeBytes      Int?
  position       Int      @default(0)
  confirmedAt    DateTime? // curadoria (NULL = pendente); o runtime só envia confirmedAt IS NOT NULL
  deletedAt      DateTime? // soft-delete (runtime/listas filtram deletedAt IS NULL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([source, sourceRef]) // dedup do materialize (upload tem sourceRef NULL → múltiplos ok)
  @@index([collectionId])
  @@index([organizationId])
  @@index([collectionId, mediaType, deletedAt])
  @@map("media_assets")
}

// ── Agent Runtime Decisions (observabilidade — Wave Orayon) ──────────────────
// Um registro por turno do runtime: que decisões o agente tomou (modelo/fallback,
// RAG hit/miss, skills, tools, memória dinâmica) + tokens/custo/latência/status.
// Tabela de LOG: sem FK (alta escrita, desacoplada); limpeza por retenção/job.
// Escrita é fire-and-forget — gravar decisão NUNCA pode derrubar o agente.
model AgentRuntimeDecision {
  id              String  @id @default(uuid())
  organizationId  String
  sessionId       String
  agentConfigId   String
  promptVersionId String?
  configHash      String?
  // Idempotência durável de turno: sha256(sessionId:inboundMessageId:configHash).
  // Nullable + @unique → Postgres permite N nulls (turnos sem id de webhook, ex.:
  // playground/builder, não participam). Um 2º dispatch do MESMO turno colide aqui
  // (P2002) e é short-circuitado ANTES do LLM — sem resposta duplicada.
  decisionIdempotencyKey String? @unique
  executionMode   String // 'sync' | 'stream' | 'playground'

  // Modelo & provider (used pode diferir de primary se houve fallback)
  modelPrimary      String
  providerPrimary   String
  modelUsed         String
  providerUsed      String
  fallbackTriggered Boolean @default(false)
  fallbackReason    String?

  // Memória & contexto
  memoryWindowSize           Int?
  dynamicWindowSize          Int?
  messagesDropped            Int     @default(0)
  previousSessionSummaryUsed Boolean @default(false)

  // RAG
  ragEnabled         Boolean @default(false)
  ragQueried         Boolean @default(false)
  ragCollectionId    String?
  ragChunksRetrieved Int     @default(0)

  // Skills & tools
  skillsActivated String[] @default([])
  enabledTools    String[] @default([])
  toolsCalled     String[] @default([])
  toolIterations  Int      @default(0)

  // Tokens & custo
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  cachedTokens Int   @default(0)
  totalTokens  Int   @default(0)
  totalCost    Float @default(0)
  // Custo de serviços EXTERNOS do turno (STT/TTS/embedding), ex.: {"stt":0.0086}.
  // Separado de totalCost (LLM) — o custo real de um turno com áudio era subestimado.
  extServiceCosts Json?

  // Latência & status
  latencyMs    Int     @default(0)
  status       String  @default("success") // 'pending' (claim pré-LLM) | 'success' | 'error' | 'fallback'
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([sessionId])
  @@index([agentConfigId, createdAt])
  @@map("agent_runtime_decisions")
}

// ── Catálogo de preços (Wave Orayon) ─────────────────────────────────────────
// Fonte de dados da tool get_pricing. DB-first (MVP); sync de Google Sheets é
// fase 2 (molde do Google Calendar). O agente aponta AIAgentConfig.priceListId.

model PriceList {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  description    String?
  currency       String  @default("BRL")
  // M2 (materialização do pricing) — espelham o card de preço (Onda B):
  disclosureStyle String @default("exact") // como o agente FALA o preço: exact|from|average|none
  minTicketCents Int? // valor mínimo de atendimento (centavos), opcional
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PriceItem[]
  agents       AIAgentConfig[] // agentes que apontam priceListId pra cá

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("price_lists")
}

model PriceItem {
  id          String   @id @default(uuid())
  priceListId String
  name        String
  priceCents  Int // preço em centavos (evita float) — piso da faixa quando 'average'
  priceMaxCents Int? // M2 — teto da faixa quando disclosureStyle='average' (> priceCents)
  imageUrl    String? // M2 — foto do catálogo visual do item (URL)
  description String?
  aliases     String[] @default([]) // sinônimos p/ busca (ex: "corte", "cabelo")
  category    String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId, isActive])
  @@map("price_items")
}

// ── Agent Prompt Versions ─────────────────────────────────────────────────────

model AgentPromptVersion {
  id            String              @id @default(uuid())
  agentConfigId String
  version       Int // Auto-increment per agent
  systemPrompt  String              @db.Text
  isActive      Boolean             @default(false)
  status        PromptVersionStatus @default(ARCHIVED)
  changelog     String?
  createdBy     String?

  // Metrics (aggregated)
  totalMessages   Int   @default(0)
  totalTransfers  Int   @default(0)
  totalCost       Float @default(0)
  avgResponseTime Float @default(0)

  createdAt DateTime @default(now())

  // Relations
  agentConfig AIAgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  creator     User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([agentConfigId, version])
  @@index([agentConfigId])
  @@index([isActive])
  @@map("agent_prompt_versions")
}

// ── Agent Tools ───────────────────────────────────────────────────────────────

model AgentTool {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String
  type           AgentToolType @default(CUSTOM)
  parameters     Json? // JSON Schema for tool parameters
  webhookUrl     String? // For CUSTOM type tools
  webhookSecret  String? // Optional secret for webhook auth
  webhookTimeout Int           @default(10000) // Timeout in ms
  isActive       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([type])
  @@map("agent_tools")
}

// ── Agent Deployments ─────────────────────────────────────────────────────────

model AgentDeployment {
  id            String            @id @default(uuid())
  agentConfigId String
  connectionId  String
  mode          AgentDeployMode   @default(CHAT)
  status        AgentDeployStatus @default(DRAFT)
  config        Json? // Mode-specific configuration (webhook URL, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  agentConfig AIAgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  connection  Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([agentConfigId])
  @@index([connectionId])
  @@index([status])
  @@map("agent_deployments")
}

// ══════════════════════════════════════════════════════════════════════════════
// [X] HOME CHAT BUILDER — Projects, Conversations, Linear Prompt Versions
// Owner: tasks/prd-quayer-builder.md  (US-001, US-002, US-003, US-004)
// Naming: prefixed "Builder*" to avoid collision with pre-existing CRM `Project`
// and `AgentPromptVersion` models.
// ══════════════════════════════════════════════════════════════════════════════

model BuilderProject {
  id             String               @id @default(uuid())
  organizationId String
  userId         String
  type           BuilderProjectType   @default(ai_agent)
  name           String               @db.VarChar(255)
  status         BuilderProjectStatus @default(draft)
  aiAgentId      String?              @unique // 1:1 with AIAgentConfig
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  archivedAt     DateTime?

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id])
  aiAgent          AIAgentConfig?              @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  conversation     BuilderProjectConversation?
  deployments      BuilderDeployment[]
  projectProviders OrganizationProvider[]
  calendarConnections CalendarConnection[]

  @@index([organizationId, type, status])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([archivedAt])
  @@map("builder_projects")
}

enum BuilderProjectType {
  ai_agent
  // Future: wa_campaign, ig_automation, wa_tracking, wa_flow, custom_tool, message_template, wa_group
}

enum BuilderProjectStatus {
  draft
  production
  paused
  archived
}

// ── Builder Project Conversations ─────────────────────────────────────────────

model BuilderProjectConversation {
  id             String    @id @default(uuid())
  projectId      String    @unique // 1:1 with BuilderProject
  organizationId String
  userId         String
  stateSummary   String?   @db.Text // auto-generated summary of project state (saves tokens in LLM ctx)
  builderState   Json? // card-owned fields + *_confirmed sentinels; null = DEFAULT_BUILDER_STATE (lazy backfill)
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  project      BuilderProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization            @relation(fields: [organizationId], references: [id])
  user         User                    @relation(fields: [userId], references: [id])
  messages     BuilderProjectMessage[]

  @@index([organizationId, userId])
  @@map("builder_project_conversations")
}

model BuilderProjectMessage {
  id             String                    @id @default(uuid())
  conversationId String
  role           BuilderProjectMessageRole
  content        String                    @db.Text
  toolCalls      Json? // array of tool call objects
  toolResults    Json? // array of tool results
  metadata       Json? // tokens in/out, model, latency, provider
  createdAt      DateTime                  @default(now())

  conversation BuilderProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("builder_project_messages")
}

enum BuilderProjectMessageRole {
  user
  assistant
  tool
  system_banner // injected info messages, not fake user messages
}

// ── Builder Prompt Versions (linear, per AIAgentConfig) ──────────────────────

model BuilderPromptVersion {
  id            String                        @id @default(uuid())
  aiAgentId     String
  versionNumber Int // linear, starts at 1, auto-increments per agent
  content       String                        @db.Text // the full system prompt
  description   String?                       @db.VarChar(500) // human-readable change description
  createdBy     BuilderPromptVersionCreatedBy @default(chat)
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime                      @default(now())

  aiAgent   AIAgentConfig @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  publisher User?         @relation("BuilderPromptVersionPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)

  @@unique([aiAgentId, versionNumber])
  @@index([aiAgentId, publishedAt])
  @@map("builder_prompt_versions")
}

enum BuilderPromptVersionCreatedBy {
  chat
  manual
  rollback
}

// ── Builder Deployments (saga state for cross-module publish) ────────────────
// Tracks the publish → create-instance → attach-connection flow.
// Allows observability, resume-on-failure, and compensating rollback.

model BuilderDeployment {
  id              String                  @id @default(uuid())
  projectId       String
  aiAgentId       String
  promptVersionId String
  instanceId      String? // WhatsApp UAZ instance id (communication/instances)
  connectionId    String? // communication/connections
  status          BuilderDeploymentStatus @default(pending)
  failureStep     String? // which saga step failed (publish | create_instance | attach)
  failureReason   String?                 @db.Text
  rolledBack      Boolean                 @default(false)
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  triggeredBy     String // userId

  project BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([aiAgentId])
  @@index([startedAt])
  @@map("builder_deployments")
}

enum BuilderDeploymentStatus {
  pending
  publishing
  instance_creating
  attaching
  live
  failed
  rolled_back
}

// ── Builder Tool Calls (observability of meta-agent tool invocations) ────────
// Every time the Builder LLM calls a tool (create-agent, attach-tool, etc),
// we log the invocation for debugging, cost tracking, and replay.

model BuilderToolCall {
  id           String                @id @default(uuid())
  messageId    String // FK BuilderProjectMessage (the assistant message that invoked)
  toolName     String                @db.VarChar(100)
  input        Json
  output       Json?
  status       BuilderToolCallStatus @default(pending)
  errorMessage String?               @db.Text
  tokensIn     Int?
  tokensOut    Int?
  latencyMs    Int?
  createdAt    DateTime              @default(now())

  @@index([messageId])
  @@index([toolName, createdAt])
  @@index([status, createdAt])
  @@map("builder_tool_calls")
}

enum BuilderToolCallStatus {
  pending
  success
  error
  approved // human-in-the-loop approval pending → granted
  rejected // human-in-the-loop rejected
}

// ── Builder Journey Events (funil da jornada v2 — NFR-04) ────────────────────
// Telemetria fire-and-forget por etapa da jornada do Builder. Padrão leve do
// BuilderToolCall: sem FK relacional (sobrevive a deletes), índices enxutos.
// Eventos REPETEM (ex.: reconexão de QR) — sem unique; funil agrega por
// MIN(createdAt) por (projectId, event). metadata NUNCA contém PII/telefone.
model BuilderJourneyEvent {
  id             String   @id @default(uuid())
  organizationId String // multi-tenant (NFR-01) — toda query filtra por ele
  projectId      String // BuilderProject.id (sem FK, igual BuilderToolCall.messageId)
  journeyVersion Int // 1 | 2 — congelado no evento
  event          String   @db.VarChar(60) // vocabulário fechado em TS (journey-events.ts)
  metadata       Json? // shape tipado sem campos livres de PII (NFR-02/LGPD)
  createdAt      DateTime @default(now())

  @@index([organizationId, event, createdAt]) // funil por org
  @@index([projectId, createdAt]) // linha do tempo por projeto
  @@map("builder_journey_events")
}

// ── Builder Context Snapshots (audit trail of context-budget compactions) ────
// When shouldCompact() triggers, we record what was compacted + summary produced.
// Enables debugging of context loss bugs and tuning of compaction thresholds.

model BuilderContextSnapshot {
  id                String                        @id @default(uuid())
  conversationId    String
  summary           String                        @db.Text
  messagesCompacted Int // how many old messages were replaced by summary
  tokensBefore      Int?
  tokensAfter       Int?
  tokensReclaimed   Int?
  triggeredBy       BuilderContextSnapshotTrigger @default(auto)
  createdAt         DateTime                      @default(now())

  @@index([conversationId, createdAt])
  @@map("builder_context_snapshots")
}

enum BuilderContextSnapshotTrigger {
  auto // shouldCompact returned true
  manual // user called /chat/compact
  exhausted // ContextBudgetExhaustedError recovery
}

// ── System Settings ───────────────────────────────────────────────────────────
// ⚠️  SystemConfig below is DEPRECATED — use SystemSettings instead

model SystemSettings {
  id        String  @id @default(uuid())
  category  String // uazapi, email, ai, concatenation, oauth, security, system
  key       String // setting key within category
  value     String  @db.Text // setting value (JSON for complex values)
  encrypted Boolean @default(false) // whether value is encrypted

  description String? // human-readable description

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String? // user id who last updated

  @@unique([category, key])
  @@index([category])
}

// ── API Keys ──────────────────────────────────────────────────────────────────

model ApiKey {
  id   String @id @default(uuid())
  name String // User-friendly name (e.g., "Production Server", "CI/CD Pipeline")

  // Key Storage (never store plain text)
  keyHash String @unique // SHA-256 hash of the full key
  prefix  String // First 8 chars for display (e.g., "qk_live_a")

  // Ownership
  organizationId String
  userId         String // Creator of the key

  // Permissions & Scope
  scopes String[] @default(["read"]) // read, write, admin, webhooks, instances, etc

  // Expiration (null = never expires)
  expiresAt DateTime?

  // Usage Tracking
  lastUsedAt DateTime?
  lastUsedIp String?
  usageCount Int       @default(0)

  // Status
  isActive  Boolean   @default(true)
  revokedAt DateTime?
  revokedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([prefix])
  @@index([isActive])
  @@index([expiresAt])
  @@map("api_keys")
}

// ── System Logs ───────────────────────────────────────────────────────────────

model LogEntry {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  // Log Classification
  level  LogLevel @default(INFO)
  source String // auth, webhook, api, database, whatsapp, ai, system
  action String? // login, message.received, webhook.failed, etc

  // Content
  message    String  @db.Text
  details    String? @db.Text // Detailed description
  stackTrace String? @db.Text

  // Context (JSON)
  context  Json? // { userId, orgId, connectionId, sessionId, requestId, etc }
  metadata Json? // Additional metadata

  // Request tracking
  requestId     String? // For request correlation
  requestPath   String? // /api/v1/auth/login
  requestMethod String? // GET, POST, etc
  statusCode    Int? // HTTP status code
  duration      Int? // Request duration in ms

  // User context
  userId         String?
  organizationId String?
  connectionId   String?
  sessionId      String?
  ipAddress      String?
  userAgent      String?

  // AI Analysis
  aiAnalysis     String?   @db.Text // AI-generated analysis
  aiAnalyzedAt   DateTime?
  aiPatternMatch String? // Detected pattern type
  aiSeverity     Int?      @default(0) // 0-10 severity score
  aiSuggestion   String?   @db.Text // AI suggestion for fix

  // Tags for filtering
  tags String[] @default([])

  // Indexes
  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@index([userId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([sessionId])
  @@index([requestId])
  @@index([aiPatternMatch])
  @@index([aiSeverity])
  @@map("log_entries")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

// AI Log Analysis Results (cached analyses — used by /api/v1/logs/analyze[/analyses])
model LogAnalysis {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Time range analyzed
  periodStart DateTime
  periodEnd   DateTime

  // Analysis type
  type String // hourly, daily, realtime, pattern

  // Results
  summary     String @db.Text // Human-readable summary
  patterns    Json // Detected patterns
  anomalies   Json // Detected anomalies
  suggestions Json // AI suggestions
  metrics     Json // Key metrics
  severity    Int    @default(0) // 0-10

  // Model info
  aiModel   String? // gpt-4o, claude-3, etc
  aiTokens  Int?
  aiCost    Float?
  aiLatency Int? // ms

  @@index([createdAt])
  @@index([type])
  @@index([periodStart, periodEnd])
  @@map("log_analyses")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Target (who receives the notification)
  userId         String? // Specific user
  organizationId String? // All users in organization
  role           String? // All users with role (admin, master, manager, etc)
  isGlobal       Boolean @default(false) // All users

  // Content
  type        NotificationType
  title       String
  description String           @db.Text
  actionUrl   String? // URL to navigate on click
  actionLabel String? // Button label (e.g., "Ver detalhes")

  // Metadata
  source   String? // auth, webhook, message, system, instance, etc
  sourceId String? // ID of related entity
  metadata Json? // Additional context data

  // Scheduling
  scheduledFor DateTime? // Future notification
  expiresAt    DateTime? // Auto-delete after

  // Status
  isActive Boolean @default(true)

  // Relations
  reads NotificationRead[]

  // Indexes
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([type])
  @@index([isGlobal])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([expiresAt])
  @@map("notifications")
}

// User's read status for notifications
model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@map("notification_reads")
}

enum NotificationType {
  MESSAGE // Nova mensagem
  USER // Relacionado a usuários
  WARNING // Alerta/Aviso
  INFO // Informativo
  SUCCESS // Sucesso/Confirmação
  ERROR // Erro
  SYSTEM // Sistema
  CONNECTION // Status de conexão
}

// ── TOTP 2FA ─────────────────────────────────────────────────────────────────

model TotpDevice {
  id        String   @id @default(uuid())
  userId    String
  secret    String // Encrypted TOTP secret
  name      String // Device/app name (e.g., "Google Authenticator")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_devices")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  code      String // Hashed recovery code (bcrypt)
  usedAt    DateTime? // Null if not yet used
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ── Device Sessions ───────────────────────────────────────────────────────────

model DeviceSession {
  id           String    @id @default(uuid())
  userId       String
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  location     String?
  countryCode  String? // Added via migration add_geo_alert_and_country_code
  lastActiveAt DateTime  @default(now())
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked])
  @@index([lastActiveAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// [7] BILLING & SUBSCRIPTIONS
// ══════════════════════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentGateway {
  EFI
  ASAAS
}

enum PaymentMethod {
  PIX_AUTO
  PIX_MANUAL
  CREDIT_CARD
  BOLETO
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PROCESSING
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

enum NfseStatus {
  PENDING_NFSE
  SCHEDULED
  SYNCHRONIZED
  AUTHORIZED
  PROCESSING_CANCELLATION
  CANCELED
  CANCELLATION_DENIED
  ERROR_NFSE
}

// ── AI Agent Enums ──────────────────────────────────────────────────────────

enum AgentToolType {
  BUILTIN
  CUSTOM
  MCP
}

enum AgentDeployMode {
  CHAT
  N8N
  CLAUDE_CODE
}

enum AgentDeployStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum PromptVersionStatus {
  ACTIVE
  TESTING
  ARCHIVED
}

// ── Plan ─────────────────────────────────────────────────────────────────────

model Plan {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  // Pricing (centavos — 14900 = R$ 149,00)
  priceMonthly Int
  priceYearly  Int?
  currency     String @default("BRL")

  // Limits
  maxUsers     Int
  maxInstances Int
  maxMessages  Int
  maxStorage   Int // MB
  maxAiCredits Int
  maxContacts  Int

  // Feature flags (explicit booleans, NOT Json)
  hasWebhooks        Boolean @default(false)
  hasApi             Boolean @default(false)
  hasCustomRoles     Boolean @default(false)
  hasSso             Boolean @default(false)
  hasAiAgents        Boolean @default(false)
  hasPrioritySupport Boolean @default(false)

  isActive  Boolean @default(true)
  isFree    Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
  @@map("plans")
}

// ── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id             String @id @default(uuid())
  organizationId String
  planId         String

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)
  isCurrent    Boolean            @default(true)

  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  canceledAt      DateTime?
  trialEndsAt     DateTime?

  // Payment gateway
  gateway            PaymentGateway @default(EFI)
  gatewayCustomerId  String?
  gatewaySubId       String?
  pixAuthorizationId String?

  paymentMethod   PaymentMethod @default(PIX_AUTO)
  lastPaymentDate DateTime?

  // Pricing snapshot (centavos)
  currentPriceCents Int
  discountCents     Int @default(0)

  // Grace period
  gracePeriodEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([organizationId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([isCurrent])
  @@map("subscriptions")
}

// ── Invoice ──────────────────────────────────────────────────────────────────

model Invoice {
  id             String @id @default(uuid())
  subscriptionId String
  organizationId String

  number      Int    @default(autoincrement())
  description String
  totalCents  Int

  status   InvoiceStatus @default(PENDING)
  issuedAt DateTime
  dueDate  DateTime
  paidAt   DateTime?

  // Payment gateway
  gateway          PaymentGateway
  gatewayPaymentId String?
  gatewayPixTxId   String?

  // NFS-e
  nfseStatus NfseStatus?
  nfseId     String?
  nfseUrl    String?

  pdfUrl   String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// ── Usage Record ─────────────────────────────────────────────────────────────

model UsageRecord {
  id             String @id @default(uuid())
  organizationId String

  period        String // e.g. "2026-04"
  messagesUsed  Int    @default(0)
  storageUsedMb Int    @default(0)
  aiCreditsUsed Int    @default(0)
  contactsCount Int    @default(0)
  apiCallsCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@map("usage_records")
}
